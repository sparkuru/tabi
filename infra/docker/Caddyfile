{
    http_port {$TABI_WEB_HTTP_PORT:80}
    https_port {$TABI_WEB_HTTPS_PORT:443}
    admin 127.0.0.1:2019
}

{$TABI_SITE_ADDRESS::80} {
    bind {$TABI_WEB_HOST:0.0.0.0}
    encode zstd gzip

    @api path /api/*
    handle @api {
        reverse_proxy api:{$TABI_API_PORT:8000}
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

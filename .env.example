# Primary local preview configuration: cp .env.example .env
# Compose parses dotenv; preview.sh never executes this file as shell code.
# Choose a separate development password. Existing database credentials must
# be coordinated separately: changing this key does not change a stored user.
POSTGRES_PASSWORD=
POSTGRES_DB=tabi
POSTGRES_USER=tabi

# Docker image references. Build application images once with ./preview.sh build.
TABI_POSTGRES_IMAGE=postgres:17-alpine
TABI_API_IMAGE=infra-api:latest
TABI_WEB_IMAGE=infra-web:latest
# Keep this absolute container path synchronized with the media volume mount.
TABI_MEDIA_ROOT=/data/media

# Database/API are reachable only inside the Compose network, never published.
TABI_DB_HOST=0.0.0.0
TABI_DB_PORT=5432
TABI_API_HOST=0.0.0.0
TABI_API_PORT=8000

# Web container listeners and host publishing are separate. When changing the
# HTTP container port, update the :port in TABI_SITE_ADDRESS as well.
TABI_WEB_HOST=0.0.0.0
TABI_WEB_HTTP_PORT=80
TABI_WEB_HTTPS_PORT=443
TABI_SITE_ADDRESS=:80
TABI_HTTP_BIND=0.0.0.0:8080
# This mapping is reserved; HTTP-only :80 does not start a TLS listener.
TABI_HTTPS_BIND=0.0.0.0:8443
TABI_COOKIE_SECURE=false
# Caddy's control API stays container-local at 127.0.0.1:2019 (not published).
# Application accounts are created via the website; no bootstrap/admin
# username or password setting is supported by the application.
